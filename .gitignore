# Secrets
.env
.env.*
!.env.example

# Personal Claude Code instructions (loaded next to CLAUDE.md, not published)
CLAUDE.local.md

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# uv / virtualenv (uv.lock IS committed — it's the version pin)
.venv/

# Jupyter
.ipynb_checkpoints/

# Editors
.vscode/
.idea/

# Hugging Face cache (if it ends up in-repo)
.cache/

# Large artifacts — kept locally, released via HF Hub.
# Directories stay in the repo via .gitkeep; contents are ignored.
data/*
!data/.gitkeep
!data/tiny/
checkpoints/*
!checkpoints/.gitkeep
runs/*
!runs/.gitkeep

# Logs and scratch
*.log
scratch/

# Probe outputs: the per-item JSON files under logs/ are artifacts (tens of MB per session) and
# go out with the checkpoints on the HF Hub release; the .txt/.md summaries and the .sh drivers
# next to them are tracked.
logs/**/*.json

logs/**/*.jsonl

# the v4 box driver's generated configs, job list and logs (scripts/run_v4.py)
logs/v4/
# HF staging tree on the boxes and the pulled runs on the Mac (scripts/hf_runs.py)
hub/
hub-v4/
hub-gd/
# the timeline / relapse and in-context dense boxes (2026-09-25): generated configs, staging trees
logs/tl2/
hub-tl2/
hub-incontext-dense/
hub-cut/
# the public release's staging trees (scripts/hf_release.py)
hub-data/
hub-runs/
# the paper's build directory and the review PNGs its figure scripts write (the PDFs are committed)
paper/build/
paper/figures/*.png
